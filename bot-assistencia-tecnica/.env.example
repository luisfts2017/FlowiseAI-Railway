# ====================================
# Configurações gerais do bot
# ====================================
# Nome da empresa exibido nas mensagens
NOME_EMPRESA=InfoTech Assistência Técnica

# Prefixo para comandos (exemplo: !menu)
PREFIXO_COMANDO=!

# Número do dono/admin no formato internacional (somente números, ex: 5511999999999)
OWNER_NUMERO=5511999999999

# Número que receberá notificações de novos orçamentos (normalmente o mesmo do owner)
NOTIFICAR_NUMERO=5511999999999

# ====================================
# Banco de dados MongoDB
# ====================================
# URL de conexão MongoDB local no Windows
MONGODB_URI=mongodb://127.0.0.1:27017/bot_assistencia_tecnica

# ====================================
# Horário de funcionamento
# ====================================
# Fuso horário do bot
FUSO_HORARIO=America/Sao_Paulo

# Hora de abertura (0-23)
HORA_ABERTURA=8

# Hora de fechamento (0-23)
HORA_FECHAMENTO=18

# Dias de atendimento (0=domingo, 1=segunda ... 6=sábado)
DIAS_ATENDIMENTO=1,2,3,4,5

# ====================================
# Segurança e controle
# ====================================
# Máximo de mensagens por minuto por número
RATE_LIMIT_POR_MINUTO=15

# Caminho de autenticação local do whatsapp-web.js
PASTA_SESSAO=./sessions

# Nome de instância para LocalAuth
CLIENT_ID=assistencia-tecnica

# Ambiente
NODE_ENV=development
